{
  "name": "capacitaciones-ic",
  "private": true,
  "version": "0.1.0",
  "description": "Respuestas para Personas Naturales — plataforma de Capacitaciones IC",
  "type": "module",
  "engines": { "node": ">=22" },
  "workspaces": ["shared", "api", "web", "infra", "e2e"],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "synth": "npm run synth --workspace infra",
    "e2e": "npm run e2e --workspace e2e",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.0.0",
    "prettier": "^3.0.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.0.0"
  }
}
